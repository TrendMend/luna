# ---- LiveKit (self-hosted server). Generate the secret: openssl rand -hex 32 ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=luna
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
# What browsers/phones connect to (compose: ws://localhost:7880; behind TLS: wss://luna.example.com)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Compose only: the address media is advertised on. 127.0.0.1 for same-machine tests; the host's LAN IP for a phone/tablet.
LIVEKIT_NODE_IP=127.0.0.1

# ---- Who may open the web UI / app: one key per device, 16+ characters. Remove a device by deleting its entry.
LUNA_ACCESS_KEYS=laptop:change-me-0123456789abcdef

# ---- Safety: 1 = read Home Assistant but do not switch anything or send notifications
LUNA_DRY_RUN=1

# ---- Home Assistant (Profile -> Security -> Long-lived access tokens) ----
HA_URL=http://192.168.1.50:8123
HA_TOKEN=

# ---- Provider keys: whatever config.yaml uses ----
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Where tool actions and caregiver notifications are logged / favourites are stored (defaults are fine locally)
# LUNA_STATE_DIR=./state
# LUNA_AUDIT_LOG=./logs/audit.jsonl
