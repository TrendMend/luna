# ---- LiveKit (self-hosted server). Generate the secret: openssl rand -hex 32 ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=luna
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
# What browsers/phones connect to (compose: ws://localhost:7880; behind TLS: wss://luna.example.com)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Compose only: the address media is advertised on. 127.0.0.1 for same-machine tests; the host's LAN IP for a phone/tablet.
LIVEKIT_NODE_IP=127.0.0.1

# ---- Who may open the web UI / app: one key per device, 16+ characters. Remove a device by deleting its entry.
LUNA_ACCESS_KEYS=laptop:change-me-0123456789abcdef

# ---- Safety: 1 = read Home Assistant but do not switch anything or send notifications
LUNA_DRY_RUN=1

# ---- Home Assistant (Profile -> Security -> Long-lived access tokens) ----
HA_URL=http://192.168.1.50:8123
HA_TOKEN=

# ---- Provider keys: whatever config.yaml uses ----
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
GOOGLE_API_KEY=            # Gemini Live (the `google` extra)
BRAVE_API_KEY=             # web_search with the brave provider (see worker/config.yaml)

# Where tool actions and caregiver notifications are logged / favourites are stored (defaults are fine locally)
# LUNA_STATE_DIR=./state
# LUNA_AUDIT_LOG=./logs/audit.jsonl

# ---- Listener (a device that runs luna-listener; its own .env): the key made by `luna-web add-device <name>`
# LUNA_ACCESS_KEY=

# ---- Optional settings, normally left alone (defaults in parentheses) ----
# LUNA_CONFIG=config.yaml                  # worker config file
# LUNA_CONFIG_OVERRIDES=                   # YAML/JSON merged over the worker config
# LUNA_AGENT_PORT=8081                     # worker health port
# LUNA_WEB_HOST=0.0.0.0                    # token service bind address
# LUNA_WEB_PORT=8080                       # token service port
# LUNA_WEB_URL=http://127.0.0.1:8080       # where the worker finds the token service (timers and reminders)
# LUNA_PUBLIC_WEB_URL=                     # the address `luna-web add-device` puts in setup links
# LUNA_WEB_DIR=                            # folder with the web UI files
# LUNA_LISTENER_CONFIG=config.yaml         # listener config file
# LUNA_LISTENER_OVERRIDES=                 # YAML/JSON merged over the listener config
# LUNA_MODELS_DIR=                         # where the listener keeps wake-word models
# LUNA_ECHO_CANCELLATION=                  # 1 or 0: listener's own echo cancellation
# LUNA_OUTPUT_GAIN=                        # listener speaker gain
